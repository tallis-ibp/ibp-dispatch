{
  "version": 2,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/webhook/:path*", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/fetch-schedule", "schedule": "0 5 * * *" },
    { "path": "/api/cron/sync-monday",    "schedule": "30 5 * * *" },
    { "path": "/api/cron/morning",        "schedule": "0 6 * * *" },
    { "path": "/api/cron/sync-monday",    "schedule": "*/30 * * * *" }
  ]
}
