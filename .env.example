# Copy this to .env and fill in your values

# Database (Supabase connection pooler — port 6543, transaction mode)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_SCHEDULER_CHAT_ID=your_personal_telegram_chat_id
TELEGRAM_WEBHOOK_SECRET=generate_a_random_string_here

# Monday.com
MONDAY_API_KEY=your_monday_api_key_here
MONDAY_BOARD_ID=2214820863

# AI
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Auth
JWT_SECRET=generate_a_random_40_plus_char_string_here

# App
PUBLIC_URL=https://your-app.vercel.app
PORT=3002
NODE_ENV=development

# Cron security (used to authenticate Vercel Cron or external cron calls)
CRON_SECRET=generate_a_random_string_here

# Google Sheet
SCHEDULE_SHEET_ID=your_google_sheet_id_here
SCHEDULE_YEAR=2026
