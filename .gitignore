# Environment & secrets — NEVER commit these
.env
.env.local
.env.*.local

# macOS
.DS_Store

# Node
node_modules/
npm-debug.log*

# Build output
dist/

# SQLite database files (local only — production uses Supabase)
data/*.db
data/*.db-shm
data/*.db-wal

# Tool-specific
.superpowers/

# Generated data (daily — don't version)
data/raw/
data/schedule-records.json
data/schedule-tabs.json
data/monday-jobs.json
data/briefs/
data/logistics/
data/flags/
data/learned-phrases.json
reports/*.md
logs/

# Keep folder placeholders
!data/.gitkeep
!reports/.gitkeep
!logs/.gitkeep
